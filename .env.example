# ===========================================
# Grupzap - Variáveis de Ambiente
# ===========================================
# Copie este arquivo para .env.local e preencha os valores

# -------------------------------------------
# Supabase
# -------------------------------------------
# URL do projeto (encontre em Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave anon/public (segura para expor no client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon

# Chave service role (NUNCA expor no client - apenas backend)
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# -------------------------------------------
# UAZAPI (WhatsApp API)
# -------------------------------------------
# URL base da sua instância UAZAPI
UAZAPI_BASE_URL=https://sua-instancia.uazapi.com

# Token de autenticação da instância
UAZAPI_TOKEN=seu-token-uazapi

# -------------------------------------------
# Vercel Cron (Mensagens Agendadas)
# -------------------------------------------
# Secret para autenticar chamadas do cron
# Gere com: openssl rand -base64 32
CRON_SECRET=sua-chave-secreta-muito-longa-aqui

# -------------------------------------------
# Stripe (Billing)
# -------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_ENTERPRISE=price_xxx
